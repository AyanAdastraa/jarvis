# ============================================================
# NVIDIA / MODEL
# ============================================================
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# ============================================================
# MODEL ROUTING
# ============================================================
FAST_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
COMPLEX_MODEL=nvidia/nemotron-3-ultra-550b-a55b
MODEL_ROUTING_ENABLED=true
MODEL_MAX_TOKENS=512
FAST_MODEL_TIMEOUT=30
NEMOTRON_TIMEOUT=180

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=sqlite:///workspace/jarvis.db

# ============================================================
# WHATSAPP
# ============================================================
# Leave empty for local development with mock mode.
# Only needed when connecting to Meta's WhatsApp Cloud API.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Set to true to enable the WhatsApp webhook server
WHATSAPP_ENABLED=false

# Set to false only when you have real Meta credentials and a phone number
WHATSAPP_MOCK_MODE=true
